{
  "name": "arduino-ide",
  "version": "0.1.0",
  "private": true,
  "description": "Offline single-file Arduino IDE for Chromebooks",
  "type": "module",
  "imports": {
    "#core": "./build/cache/wasm/core/aide_wasm.js",
    "#boot": "./build/cache/wasm/boot/aide_boot.js",
    "#boot-wasm": "./build/cache/wasm/boot/aide_boot_bg.wasm",
    "#compiler-worker": "./build/cache/compiler-worker.txt"
  },
  "scripts": {
    "build": "cargo aide build",
    "watch": "cargo aide build --watch",
    "test": "cargo test --workspace && cargo aide wasm && node --test test/*.test.js"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.4",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "serialport": "^13.0.0"
  }
}
